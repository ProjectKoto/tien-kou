# For wrangler local dev

PROFILE_NAME = 'release'

SHOULD_INCLUDE_UNRELEASED_ASSETS = '0'

PROCENV_TK_HOARD_SUB_MODE = 'hoardLocalOnly'

# if have subpath: subpath must end with / . hrana v2/pipeline is a relative path (without prefix /) to base url.
TURSO_DATABASE_URL = "libsql://xxx.turso.io"
# for turso official libsql server: jwt, no prefix needed; for self-hosted libsql-server/sqld
# using http basic auth: prefix with "basic:", seems any string following is ok (base64 of
# "user:password" is not enforced by code), and client side doesn't need any handling besides
# stripping "basic:" (sqld http auth logic: ignore chars before first space, "Bearer", "Basic"
# both ok; check the following string *contains* (rather than equals) the correct token. and
# "accept" accepts all)
# see libsql: libsql-server/src/main.rs, comment of http_auth config field;
# see libsql: libsql-server/src/auth/user_auth_strategies/http_basic.rs

# TURSO_DATABASE_URL_FOR_HOARD_UPLOAD = "libsql://..."
# TURSO_DATABASE_URL_FOR_SERVE_BACKEND = "libsql://..."

TURSO_AUTH_TOKEN = "xxx"
# or configure TURSO_EXPOSE_SECRET_PATH as a secret
TURSO_EXPOSE_SECRET_PATH = "my-secret-path"
# TURSO_DISABLE_TLS = "0"
HTTP_PROXY = "http://127.0.0.1:8118"
DEBUG = "proxy-agent,knex:query"

MARKDOWNDB_DB_PATH = 'markdown.db'

# use backticks. see: https://www.npmjs.com/package/dotenv FAQ: "What rules does the parsing engine follow?"
# syntax:
# js regex literal-like: /.../gi (different from js: you dont need to escape "/" inside the regex)
# without / wrapped, but with optional suffix +i:   ...+i (ignore case)   or  ... (do not ignore case)
# the right side: ReplacerFunc(...) means using a replacer function.
# use %c to represent literal comma ",", use %e to represent literl equal sign "=".
DEDICATED_SOURCE_REGEX_REPLACE_LIST = ``
# a special shorthand using ReplacerFunc(replaceTagHandler), executed last in DedicatedSourceRegexReplace.
DEDICATED_SOURCE_TAG_REPLACE_CASE_INSENSITIVE_LIST = `fhn=FromHn,til=TodayILearned,ril=ReadItLater`
DEDICATED_SOURCE_TAG_REPLACE_CASE_SENSITIVE_LIST = `CoT=ChainOfThought`

HOARD_DB_BATCH_DEBUG_MODE = "0"

HOARD_DATA_UPDATE_CALLBACK_URL_LIST = "http://127.0.0.1:8568/admin/refreshSiteVersion;http://127.0.0.1:8569/admin/refreshSiteVersion;http://127.0.0.1:8571/admin/refreshSiteVersion;https://mysite.dev/admin/refreshSiteVersion"
HOARD_DATA_UPDATE_RECACHE_URL_LIST = "http://127.0.0.1:8568/precache;http://127.0.0.1:8569/precache;http://127.0.0.1:8571/precache;https://mysite.dev/precache"

# run hoard in an interactive shell once to ensure all information set up required for log in to telegram.
TELEGRAM_API_ID = "11111"
TELEGRAM_API_HASH = "xxxxxx"
# socks
TELEGRAM_PROXY_PORT = "1080"
# SHOULD_HOARD_DROP_REMOTE_META_META = "1"
# SHOULD_HOARD_DROP_REMOTE_FILES_TABLE_INSTEAD_OF_VIEW = "1"

TELEGRAM_HOARD_DISABLE = '0'
# optional
# TELEGRAM_HOARD_DEST_BASE_PATH = "/path/to/tg_hoard_dest"
# gram.js forces the dir in cwd, so only the name can be customized...
TELEGRAM_HOARD_SESSION_DIR_NAME = "tg_session"
TELEGRAM_RELEASE_HOARD_DEST_BASE_PATH = "/path/to/tg_rel_hoard_dest"
TELEGRAM_HOARD_TRIGGERING_REPLY_PREFIX = 'pub'
TELEGRAM_LOGIN_USE_QRCODE = '0'

NODE_LOCAL_FS_LIVE_ASSET_BASE_PATH = "..../liveAsset"
NODE_LOCAL_FS_STATIC_ASSET_BASE_PATH = "..../staticAsset"
NODE_STATIC_GEN_BASE_PATH = "./data/staticGen"
NODE_STATIC_GEN_URL_BASE = "https://pseudo-tien-kou-app.home.arpa"
NODE_CLOUD_RT_LISTEN_HOST = '127.0.0.1'
NODE_CLOUD_RT_LISTEN_PORT = '8571'
NODE_LOCAL_FS_RT_LISTEN_HOST = '127.0.0.1'
NODE_LOCAL_FS_RT_LISTEN_PORT = '8569'

SERVE_SQL_QUERY_DEBUG_LOG = '0'

HEAVY_ASSET_WEB_REDIR_URL_PREFIX = "https://my.static.asset.site/sub/path/"

HOARD_FILE_SYNC_RELATED_DISABLE = '0'

HOARD_MULTI_TARGET_SYNC_BASE_DIR = 'path/to/xxx'

HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_TYPE = 'xxx'
HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_PROVIDER = 'xxx'
HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_ENV_AUTH = 'xxx'
HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_ACCESS_KEY_ID = 'xxx'
HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_SECRET_ACCESS_KEY = 'xxx'
HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_ENDPOINT = 'https://xxx'
HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_LOCATION_CONSTRAINT = 'xxx'
HOARD_RCLONE_CONFIG_TK_HOARD_HEAVY_SYNC_ACL = 'xxx'

HOARD_RCLONE_TK_HOARD_HEAVY_DEST_DIR = 'path/to/xxx'

HOARD_RCLONE_EXECUTABLE = 'path/to/rclone'

# UTC+8
PROCENV_HOARD_METADATA_DATE_TIMEZONE_OFFSET_MINUTE = '480'
# UTC+8
LIQUID_DATE_TIMEZONE_OFFSET_MINUTE = '480'

# HOARD_METADATA_FIELD_ALIAS_LIST = 'ref:groupType=ref&...'


HOARD_GIT_LOCAL_LIVE_ASSET_BARE_REPO_PATH = '/path/to/repo.git'
HOARD_GIT_LOCAL_STATIC_GEN_BARE_REPO_PATH = '/path/to/static-gen-repo.git'

# run hoard in an interactive shell once to ensure credential correctly set up.
# use GIT_CONFIG to specify alternative config file path, or use GIT_SSH_COMMAND to
# append command line options to ssh invoked by git.
# also it is recommended to set up:
# GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0=store
# or:
# GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0=cache
# or:
# GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=credential.https://example.com.username GIT_CONFIG_VALUE_0=x-access-token GIT_CONFIG_KEY_1=credential.https://example.com.helper GIT_CONFIG_VALUE_1='!f() { test "$1" = get && echo "password=my-github-token"; }; f'

HOARD_GIT_LIVE_ASSET_REMOTE = 'ssh://xxx'
HOARD_GIT_STATIC_GEN_REMOTE = 'ssh://xxx2'

PROCENV_HOARD_MARKDOWNDB_FILES_JSON_PATH = '/path/to/.markdowndb/files.json'

PROCENV_CACHE_LRU_SQLITE_PATH = './lruCache.sqlite'
